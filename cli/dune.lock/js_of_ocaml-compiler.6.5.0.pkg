(version 6.5.0)

(build
 (all_platforms
  ((action
    (progn
     (run dune build -p %{pkg-self:name} -j %{jobs} @install)
     (run
      cmdliner
      install
      tool-support
      --update-opam-install=%{pkg-self:name}.install
      (when
       (catch_undefined_var (<> %{os_family} windows) false)
       _build/install/default/bin/js_of_ocaml)
      (when
       (catch_undefined_var (= %{os_family} windows) false)
       _build/install/default/bin/js_of_ocaml.exe:js_of_ocaml)
      _build/cmdliner-install)
     (run
      cmdliner
      install
      tool-support
      --update-opam-install=%{pkg-self:name}.install
      (when
       (catch_undefined_var (<> %{os_family} windows) false)
       _build/install/default/bin/jsoo_minify)
      (when
       (catch_undefined_var (= %{os_family} windows) false)
       _build/install/default/bin/jsoo_minify.exe:jsoo_minify)
      _build/cmdliner-install))))))

(depends
 (all_platforms
  (dune
   ocaml
   ppxlib
   ocaml-compiler-libs
   cmdliner
   sedlex
   menhir
   menhirLib
   menhirSdk
   yojson)))

(source
 (fetch
  (url
   https://github.com/ocsigen/js_of_ocaml/releases/download/6.5.0/js_of_ocaml-6.5.0.tbz)
  (checksum
   sha512=ce476986cb2c78990f29b1d7a01bb173a0d30ad0e0a80ba7bde9aa8365952ed01eda4935d92a323b982b0c1c897b20ef01eabe75fe80e4da858f73f6a2d25232)))
