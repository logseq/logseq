  "scripts": {
    "watch": "run-p gulp:watch ui:dune-watch ui:vite-watch app:serve css:watch",
    "electron-watch": "run-p gulp:watch ui:dune-watch ui:vite-watch app:serve electron:dune-watch electron:vite-watch",
    "release": "run-s gulp:build ui:build db-worker:build",
    "dev-electron-app": "gulp electron",
    "release-electron": "run-s gulp:build && gulp electronMaker",
    "release-electron:unsigned": "run-s gulp:build && gulp electronMakerUnsigned",
    "debug-electron": "cd static/ && pnpm electron:debug",
    "clean": "gulp clean",
    "test": "run-s test:db-worker test:ui",
    "test:node-adapter": "pnpm --dir deps/db-sync run test:node-adapter",
    "style:lint": "stylelint \"resources/css/**/*.css\"",
    "gulp:watch": "gulp watch",
    "gulp:build": "cross-env NODE_ENV=production gulp build",
    "css:build": "postcss tailwind.all.css -o static/css/style.css --verbose --env production",
    "css:watch": "cross-env TAILWIND_MODE=watch postcss tailwind.all.css -o static/css/style.css --verbose --watch",
    "electron:build": "cd deps/db-worker && opam exec -- dune build js_api && pnpm exec vite build --mode electron",
    "electron:dune-watch": "cd deps/db-worker && opam exec -- dune build js_api --watch",
    "electron:vite-watch": "cd deps/db-worker && pnpm exec vite build --mode electron --watch",
    "publishing:build": "run-s gulp:build ui:build",
    "test:publishing": "cd deps/db-worker && opam exec -- dune build js_api test/native/test_publishing_native.exe && cd ../.. && node scripts/test-publishing.mjs",
    "db-worker-node:compile": "pnpm db-worker:build",
    "db-worker-node:release": "pnpm db-worker:build",
    "db-worker-node:bundle": "node ./scripts/build-db-worker-node-bundle.mjs",
    "db-worker-node:release:bundle": "run-s db-worker:build db-worker-node:bundle",
    "db-worker-node:compile:bundle": "run-s db-worker:build db-worker-node:bundle",
    "db-worker-node:native": "cd deps/db-worker && opam exec -- dune build bin/main.exe",
    "db-worker:build": "opam exec -- pnpm --dir deps/db-worker build",
    "cli:release": "pnpm --dir cli bundle && node ./scripts/stage-cli-runtime.mjs",
    "desktop:prepare-runtime-js": "node ./scripts/prepare-desktop-runtime-js.mjs",
    "cli:e2e": "bb dev:cli-e2e",
    "cli:e2e:skip-build": "bb dev:cli-e2e --skip-build",
    "app:serve": "node scripts/serve-static.mjs",
    "ui:build": "cd deps/db-worker && opam exec -- dune build js_api && cd ../ui && opam exec -- dune build js_app && ../../node_modules/.bin/vite build",
    "ui:dune-watch": "cd deps/ui && opam exec -- dune build js_app --watch",
    "ui:vite-watch": "cd deps/ui && ../../node_modules/.bin/vite build --watch",
    "test:db-worker": "cd deps/db-worker && opam exec -- dune runtest",
    "test:ui": "cd deps/ui && opam exec -- dune build test && node _build/default/test/ui_test/test/test_main.js && opam exec -- dune runtest test/contracts"
  },
  "dependencies": {
