  "private": true,
  "packageManager": "pnpm@10.33.0",
  "main": "static/electron.js",
  "bin": {
    "logseq": "dist/logseq.js"
  },
  "files": [
    "dist/",
    "static/logseq-cli.js",
    ".agents/skills/logseq-cli/SKILL.md"
  ],
