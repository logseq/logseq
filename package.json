    "cross-env": "^10.1.0",
    "cssnano": "^7.1.8",
    "gulp": "^5.0.1",
    "gulp-postcss": "^10.0.0",
    "npm-run-all2": "^9.0.3",
    "playwright": "1.58.2",
    "postcss": "^8.5.13",
    "postcss-cli": "12.0.0",
    "postcss-import": "17.0.0",
    "postcss-import-ext-glob": "2.1.1",
    "postcss-nested": "8.0.1",
    "process": "^0.11.10",
