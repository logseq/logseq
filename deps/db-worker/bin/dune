(executable
 (name main)
 (public_name db-worker-node)
 (modes native)
 (libraries logseq_db_worker logseq_db_worker_platform_native
  logseq_db_worker_sqlite_vendored))

;; macOS arm64 only. Dune rejects an empty copy_files glob, which fails
;; `dune build` on every other platform.
(copy_files
 (files ../runtime/native/zvec/*.dylib)
 (enabled_if
  (and
   (= %{system} macosx)
   (= %{architecture} arm64))))

(copy_files
 (files ../runtime/native/zvec/ZVEC-*)
 (enabled_if
  (and
   (= %{system} macosx)
   (= %{architecture} arm64))))
