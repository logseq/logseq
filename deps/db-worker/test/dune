(melange.emit
 (target test_node)
 (alias test_node)
 (module_systems commonjs)
 (modules
  test_worker_melange
  test_query_melange
  test_crypt_melange
  test_db_worker_node_melange
  test_time_melange)
 (libraries
  logseq_db_worker
  logseq_db_worker_platform_melange
  melange-fest
  melange.node
  melange.js)
 (preprocess
  (pps melange.ppx)))

(rule
 (alias runtest)
 (deps
  (alias test_node)
  (:test_js ./test_node/test/test_worker_melange.js)
  (:test_query_js ./test_node/test/test_query_melange.js)
  (:test_crypt_js ./test_node/test/test_crypt_melange.js)
  (:test_node_js ./test_node/test/test_db_worker_node_melange.js)
  (:test_time_js ./test_node/test/test_time_melange.js))
 (action
  (run node --test %{test_js} %{test_query_js} %{test_crypt_js}
    %{test_node_js} %{test_time_js})))

(executable
 (name test_worker_native)
 (modes native)
 (libraries
  logseq_db_worker
  logseq_db_worker_platform_native
  unix))

(executable
 (name test_query_native)
 (modes native)
 (libraries
  logseq_db_worker
  logseq_db_worker_platform_native
  unix))

(executable
 (name test_sync_native)
 (modes native)
 (libraries
  logseq_db_worker
  logseq_db_worker_platform_native
  unix))

(executable
 (name test_render_native)
 (modes native)
 (libraries
  logseq_db_worker
  logseq_db_worker_platform_native
  unix))

(rule
 (alias runtest)
 (deps
  (:test_bin ./test_worker_native.exe)
  (:test_query_bin ./test_query_native.exe)
  (:test_sync_bin ./test_sync_native.exe)
  (:test_render_bin ./test_render_native.exe))
 (action
  (progn
   (run %{test_bin})
   (run %{test_query_bin})
   (run %{test_sync_bin})
   (run %{test_render_bin}))))
