(rule
 (copy ../../ocaml_host/ocaml_host_stubs.c chrome_host_stubs.c))

(rule
 (copy ../../native/native_embed.ml native_embed_snapshot.ml))

(test
 (name chrome_layout_test)
 (modules chrome_layout_test native_embed_snapshot)
 (libraries logseq_ui_ocamlhost native_host_test_support lui.layout lui.store)
 (foreign_stubs
  (language c)
  (names chrome_host_stubs)
  (flags (:standard (:include ../../ocaml_host/host_c_flags.sexp))))
 (link_flags (:standard (:include ../../ocaml_host/host_link_flags.sexp)))
 (preprocess (pps lui.ppx))
 (action
  (setenv LOGSEQ_UI_STATE_DIR %{workspace_root}/test/native_host/chrome-state
   (run %{test})))
 (enabled_if (or (= %{system} macosx) (= %{system} linux))))

