(include_subdirs no)

(library
 (name logseq_ui_shared)
 (wrapped false)
 (modes byte native melange)
 (libraries lui logseq_ui_contracts)
 (preprocess (pps lui.ppx)))

; The package metadata lives outside this Dune project. Re-read it on
; every build so changing the release version cannot leave stale
; metadata. Single generation shared by all runtimes.
(rule
 (target version_gen.ml)
 (deps (universe))
 (action
  (run
   sh
   -c
   "%{exe:../../tools/version_gen.exe} \"$DUNE_SOURCEROOT/../../resources/package.json\" %{target}")))

; Icon-name table for the icon picker — assets/icon-names.json is
; inside this project so it stays a tracked dep. Single generation
; shared by all runtimes.
(rule
 (target icon_names_data.ml)
 (deps ../../assets/icon-names.json)
 (action
  (run %{exe:../../tools/icon_names_gen.exe} %{deps} %{target})))
; CSS and native share one palette source and one channel generator.
(rule
 (target ui_theme_radix.ml)
 (deps (universe))
 (action
  (run
   sh
   -c
   "node \"$DUNE_SOURCEROOT/../../scripts/generate-ui-radix.mjs\" \"$DUNE_SOURCEROOT/../../resources/css/theme/radix.css\" %{target}")))
