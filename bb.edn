{:paths ["scripts/src" "resources"]
 :deps
 {metosin/malli
  {:git/url "https://github.com/metosin/malli"
   :sha     "76603d587553c5a8d60fa64c9e631fa3addb4b2e"}
  borkdude/rewrite-edn {:mvn/version "0.6.10"}
  logseq/bb-tasks
  #_{:local/root "../bb-tasks"}
  {:git/url "https://github.com/logseq/bb-tasks"
   :git/sha "957318b81b22099484f1e9817d4d9d7b8598fdf6"}
  logseq/graph-parser
  {:local/root "deps/graph-parser"}
  org.clj-commons/digest
  {:mvn/version "1.4.100"}
  cheshire/cheshire
  {:mvn/version "6.2.0"}}
 :pods
 {clj-kondo/clj-kondo {:version "2026.08.04"}
  org.babashka/fswatcher {:version "0.0.7"}
  org.babashka/go-sqlite3 {:version "0.3.13"}}
 :tasks
 {dev:desktop-watch
  logseq.tasks.dev.desktop/watch

  libs:generate-cljs-sdk
  {:doc "Generate CLJS wrappers based on the JS SDK declarations"
   :requires ([logseq.libs.sdk-generator :as sdk-gen])
   :task (sdk-gen/run! (sdk-gen/parse-args *command-line-args*))}

  dev:open-dev-electron-app
  logseq.tasks.dev.desktop/open-dev-electron-app

  -dev:electron-start
  {:depends [dev:desktop-watch dev:open-dev-electron-app]}

  dev:electron-start
  {:doc "Start electron dev by watching assets and opening dev app"
   ;; Parallel execution - https://book.babashka.org/#parallel
   :task (run '-dev:electron-start {:parallel true})}

  -dev:build-publishing-frontend
  logseq.tasks.dev/build-publishing-frontend

  dev:publishing-backend
  logseq.tasks.dev/publishing-backend

  -dev:publishing-release
  {:depends [-dev:build-publishing-frontend]
   :doc "Build release publishing spa app given graph and output dirs"
   :task (run 'dev:publishing-backend)}

  dev:publishing
  {:doc "Build a LUI publishing site from graph and output directories. Use --dev to retain source maps."
   :task (run '-dev:publishing-release)}

  dev:query
  {:doc "Query a DB graph's datascript db"
   :requires ([babashka.fs :as fs])
   :task (apply shell {:dir "deps/db" :extra-env {"ORIGINAL_PWD" (fs/cwd)}}
                "pnpm exec nbb-logseq script/query.cljs" *command-line-args*)}

  dev:transact
  {:doc "Transact against a DB graph's datascript db"
   :requires ([babashka.fs :as fs])
   :task (apply shell {:dir "deps/outliner" :extra-env {"ORIGINAL_PWD" (fs/cwd)}}
                "pnpm exec nbb-logseq script/transact.cljs" *command-line-args*)}

  dev:create
  {:doc "Create a DB graph given a sqlite.build EDN file"
   :requires ([babashka.fs :as fs])
   :task (apply shell {:dir "deps/db" :extra-env {"ORIGINAL_PWD" (fs/cwd)}}
                "pnpm exec nbb-logseq -cp src:../outliner/src:script script/create_graph.cljs" *command-line-args*)}

  dev:create-clojure-log-graph
  {:doc "Import local clojure-log chats into a DB graph"
   :task (apply shell {:dir "deps/outliner"}
                "pnpm exec nbb-logseq ../../scripts/src/logseq/tasks/db_graph/create_graph_with_clojure_irc_history.cljs"
                *command-line-args*)}

  dev:import
  {:doc "Import a file graph to db graph"
   :requires ([babashka.fs :as fs])
   :task (apply shell {:dir "deps/graph-parser" :extra-env {"ORIGINAL_PWD" (fs/cwd)}}
                "pnpm exec nbb-logseq -cp src:../outliner/src script/db_import.cljs" *command-line-args*)}

  dev:import-many
  {:doc "Import multiple file graphs to db graphs"
   :task logseq.tasks.dev/db-import-many}

  dev:datoms
  {:doc "Write db's datoms to a file"
   :requires ([babashka.fs :as fs])
   :task (apply shell {:dir "deps/db" :extra-env {"ORIGINAL_PWD" (fs/cwd)}}
                "pnpm exec nbb-logseq script/dump_datoms.cljs"
                *command-line-args*)}

  dev:diff-datoms
  logseq.tasks.dev/diff-datoms

  dev:test
  logseq.tasks.dev/test

  dev:lint-and-test
  logseq.tasks.dev/lint-and-test

  dev:lint-test-deps
  logseq.tasks.dev.lint-test-deps/run

  dev:db-sync-test
  {:doc "Run db-sync server unit tests"
   :task (do (shell {:dir "deps/db-sync"} "clojure -M:cljs compile db-sync-test")
             (shell {:dir "deps/db-sync"} "node worker/dist/worker-test.js"))}

  dev:db-sync-start
  {:doc "Start db-sync local server + client watch processes in foreground"
   :task logseq.tasks.dev.db-sync/start}

  dev:db-worker-node
  {:doc "Build the OCaml db-worker bundle and start db-worker-node (pass-through args forwarded to node)"
   :task (do
           (shell "pnpm" "db-worker:build")
           (apply shell "node" "./static/db-worker-node.js" *command-line-args*))}

  dev:cli-e2e
  {:doc "Run shell-first CLI end-to-end tests"
   :task (apply shell {:shutdown nil} "bb" "-f" "cli-e2e/bb.edn" "test" *command-line-args*)}

  dev:cli-e2e-cleanup
  {:doc "Run shell-first CLI end-to-end cleanup"
   :task (apply shell {:shutdown nil} "bb" "-f" "cli-e2e/bb.edn" "cleanup" *command-line-args*)}

  dev:cli-e2e-sync
  {:doc "Run shell-first CLI sync end-to-end tests"
   :task (apply shell {:shutdown nil} "bb" "-f" "cli-e2e/bb.edn" "test-sync" *command-line-args*)}

  lint:dev
  logseq.tasks.dev.lint/dev

  nbb:watch
  logseq.bb-tasks.nbb.watch/watch

  nbb:portal-watch
  logseq.bb-tasks.nbb.watch/portal-watch

  lang:list
  logseq.tasks.lang/list-langs

  lang:missing
  logseq.tasks.lang/list-missing

  lang:pseudo
  logseq.tasks.lang/list-pseudo

  lang:format-dicts
  logseq.tasks.lang/format-dicts

  lang:validate-translations
  logseq.tasks.lang/validate-translations

  lang:lint-hardcoded
  logseq.tasks.lang/lint-hardcoded}}
